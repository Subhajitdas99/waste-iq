# ==================================================
# Waste-IQ AI Engineering Agent - environment
# Copy to .env and fill in real values. Never commit .env.
# ==================================================

# GitHub App credentials (see docs/architecture/AI_ENGINEERING_AGENT.md §5.1)
AGENT_GITHUB_APP_ID=
# Inline PEM private key (multi-line) OR set AGENT_GITHUB_APP_PRIVATE_KEY_PATH
AGENT_GITHUB_APP_PRIVATE_KEY=
AGENT_GITHUB_APP_PRIVATE_KEY_PATH=
AGENT_GITHUB_INSTALLATION_ID=
AGENT_WEBHOOK_SECRET=

# Runtime
AGENT_ENVIRONMENT=development
AGENT_LOG_LEVEL=INFO
AGENT_DATABASE_URL=sqlite:///./agent.db

# Protects the /api/admin endpoints. A random string; pass as `Authorization: Bearer <token>`.
AGENT_ADMIN_API_TOKEN=

# --- Repository Context Service (Phase 1) ---
# Root of the repository tree to index for the semantic context service.
AGENT_REPOSITORY_ROOT=..
# Sub-trees of the repository that are indexed (relative to the root).
AGENT_CONTEXT_ROOTS=backend,frontend,docs,.github
# Chunk sizes (token estimates)
AGENT_CHUNK_MIN_TOKENS=450
AGENT_CHUNK_MAX_TOKENS=1000
# Vector store: memory (Phase 1) | qdrant
AGENT_VECTOR_STORE=memory
AGENT_QDRANT_URL=
AGENT_QDRANT_LOCAL_PATH=
AGENT_QDRANT_COLLECTION=waste_iq_agent
# Embedding provider: memory (Phase 1, no LLM calls) | openai | ollama
AGENT_EMBEDDING_PROVIDER=memory
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_OLLAMA_URL=http://localhost:11434
AGENT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Run a full index pass after startup (migrations run first).
AGENT_INDEX_ON_STARTUP=true
AGENT_INDEX_STARTUP_DELAY_SECONDS=0
AGENT_EMBED_BATCH_SIZE=32
# --- Issue Assistant (Phase 3) ---
# Triage suggestions on new issues. Propose-only: the assistant never
# changes labels/milestones/state. Comment posting is opt-in.
AGENT_ISSUE_ENABLED=true
AGENT_ISSUE_AUTO_RUN=true
AGENT_ISSUE_COMMENTS_ENABLED=false
AGENT_ISSUE_DUPLICATE_THRESHOLD=0.35
AGENT_ISSUE_MAX_DUPLICATES=3

# --- Documentation Agent (Phase 4) ---
# Propose changelog entries + doc-drift suggestions on merged PRs.
# Patch PRs (the agent's only repo write, on agent/docs-* branches) require
# the "/agent docs apply" command on the proposal comment AND this flag.
AGENT_DOCS_ENABLED=true
AGENT_DOCS_AUTO_RUN=false
AGENT_DOCS_COMMENTS_ENABLED=false
AGENT_DOCS_PATCH_PR_ENABLED=false
AGENT_DOCS_DEFAULT_BASE=develop
AGENT_DOCS_CHANGELOG_PATH=CHANGELOG.md

# --- Evaluation & Benchmark Framework (Phase 4.5) ---
# Deterministic benchmark over the six agent capabilities. Run:
#   python scripts/run_evaluation.py
# The run indexes the repository, executes all auto cases, and exits non-zero
# unless every quality gate passes (Repository Search >= 90, Grounding = 100,
# Hallucinations = 0, Overall >= 90). Results land in docs/evaluation/.
AGENT_BENCHMARK_VERSION=1.0.0
# Path where the last benchmark state (for /api/evaluation/status) is stored.
AGENT_EVALUATION_STATE_PATH=agent/evaluation_state.json
