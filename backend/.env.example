DATABASE_URL=sqlite:///wasteiq.db
ENVIRONMENT=development
JWT_SECRET_KEY=dev_secret_key_change_me
JWT_ALGORITHM=HS256
# Access tokens are short-lived JWTs (default 30 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh tokens are opaque 384-bit secrets, stored server-side as SHA-256
# digests, rotated on every use, and revoked on logout/password change.
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173

# Cloudinary Configuration for Image Uploads
# Development: if these are left blank, uploads are skipped and image_url is
# stored as NULL (explicit dev fallback).
# Production (ENVIRONMENT=production): ALL three are REQUIRED. Missing or
# invalid credentials fail the upload with 503 (not configured) or 502
# (provider unavailable) rather than silently dropping the image.
# Uploaded images are stored under pickups/{user_id}/{uuid} and the Cloudinary
# public_id is persisted (image_public_id) so the asset can be deleted when the
# pickup request is cancelled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Logging
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
LOG_LEVEL=INFO

# Optional: Rate Limiting (in-memory, per-process; not shared across instances)
# Maximum login attempts per IP per RATE_LIMIT_WINDOW_SECONDS.
LOGIN_RATE_LIMIT_MAX=10
# Maximum login attempts per account email per RATE_LIMIT_WINDOW_SECONDS.
LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
# Maximum registrations per IP per RATE_LIMIT_WINDOW_SECONDS.
REGISTER_RATE_LIMIT_MAX=10
# Maximum forgot-password requests per IP per RATE_LIMIT_WINDOW_SECONDS.
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
# Maximum verification-email resends per IP per RATE_LIMIT_WINDOW_SECONDS.
RESEND_VERIFICATION_RATE_LIMIT_MAX=5
# Length of the rate-limit sliding window in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# Failed login attempts before the account is locked (counter resets on lock).
LOCKOUT_FAILED_ATTEMPT_THRESHOLD=5
# Duration of the account lockout in minutes.
LOCKOUT_COOLDOWN_MINUTES=15

# Email Verification (WIQ-V1-014)
# console (default) logs a redacted delivery summary and keeps messages in an
# in-process outbox; smtp sends real mail via the SMTP host below.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# From-address and display name used on outgoing emails.
EMAIL_FROM=
EMAIL_FROM_NAME=Waste-IQ
# Base URL of the frontend used to build verification links.
FRONTEND_URL=http://localhost:5173
# Verification tokens expire after this many minutes (default 1440 = 24 hours).
VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Optional: Sentry Error Tracking
# Leave SENTRY_DSN empty to disable Sentry.
# Set RELEASE to your application version or git tag.
SENTRY_DSN=
RELEASE=local
