DATABASE_URL=sqlite:///wasteiq.db
ENVIRONMENT=development
JWT_SECRET_KEY=dev_secret_key_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Optional: Cloudinary Configuration for Image Uploads
# If these are not provided, local development will skip uploads and save image_url as NULL.
# In production, valid credentials are required for image uploads to succeed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Logging
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
LOG_LEVEL=INFO

# Optional: Sentry Error Tracking
# Leave SENTRY_DSN empty to disable Sentry.
# Set RELEASE to your application version or git tag.
SENTRY_DSN=
RELEASE=local
